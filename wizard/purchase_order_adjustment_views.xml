<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_adjustment_form" model="ir.ui.view">
        <field name="name">mayan.purchase.order.adjustment.form</field>
        <field name="model">mayan.purchase.order.adjustment</field>
        <field name="arch" type="xml">
            <form string="Ajustar pendientes de compra">
                <div class="alert alert-info" role="alert">
                    Seleccione los productos que el proveedor ya no entregará.
                    Las líneas sin recepción se eliminarán; las demás quedarán con la cantidad recibida.
                    Se cancelará el pendiente de las líneas seleccionadas y se registrará el ajuste en el historial.
                </div>
                <group>
                    <field name="order_id" options="{'no_open': True}"/>
                    <field name="reason" placeholder="Ejemplo: el proveedor confirmó que no surtirá el saldo pendiente."/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected"/>
                        <field name="purchase_line_id" column_invisible="True" force_save="1"/>
                        <field name="product_id" options="{'no_open': True}"/>
                        <field name="ordered_qty" force_save="1"/>
                        <field name="received_qty" force_save="1"/>
                        <field name="pending_qty"/>
                        <field name="product_uom_id" groups="uom.group_uom"/>
                        <field name="operation"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar ajuste" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
